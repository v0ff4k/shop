{
    "id": null,
    "uid": "shop-overview",
    "title": "Shop Overview",
    "tags": ["shop"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
        {
            "id": 1,
            "title": "HTTP Requests Total",
            "type": "graph",
            "targets": [
                {
                    "expr": "rate(app_http_requests_total[5m])",
                    "legendFormat": "{{method}} {{path}} - {{status}}"
                }
            ],
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
        },
        {
            "id": 2,
            "title": "Request Duration",
            "type": "graph",
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, rate(app_http_request_duration_seconds_histogram_bucket[5m]))",
                    "legendFormat": "95th percentile"
                }
            ],
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
        },
        {
            "id": 3,
            "title": "Exceptions Total",
            "type": "singlestat",
            "targets": [
                {
                    "expr": "sum(rate(app_http_exceptions_total[5m]))",
                    "legendFormat": "Exceptions/sec"
                }
            ],
            "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8}
        },
        {
            "id": 4,
            "title": "Active Requests",
            "type": "gauge",
            "targets": [
                {
                    "expr": "app_http_request_duration_seconds",
                    "legendFormat": "Duration"
                }
            ],
            "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8}
        }
    ],
    "overwrite": true
}
