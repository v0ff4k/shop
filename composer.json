{
    "name": "v0ff4k/shop",
    "license": "proprietary",
    "authors": [
        {
            "name": "Vladimir"
        }
    ],
    "type": "project",
    "description": "Test web market called as SHOP",
    "prefer-stable": true,
    "minimum-stability": "stable",
    "require": {
        "php": "8.2.*",
        "ext-amqp": "*",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-xml": "*",
        "ext-zip": "*",

        "doctrine/collections": "^2.6",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^2.19",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/instantiator": "2.0.0",
        "doctrine/orm": "^3.7",
        "scienta/doctrine-json-functions": "^6.5",

        "lcobucci/jwt": "^5.2",
        "league/flysystem": "^3.23",
        "league/flysystem-bundle": "^3.2",
        "promphp/prometheus_client_php": "^2.15",

        "ramsey/uuid": "^4.7",
        "ramsey/uuid-doctrine": "^2.0",
        "ruflin/elastica": "^8.2",

        "roave/security-advisories": "dev-master",

        "open-telemetry/exporter-otlp": "^1.0",
        "open-telemetry/sdk": "^1.0",

        "sonata-project/admin-bundle": "^4.43",
        "sonata-project/doctrine-orm-admin-bundle": "^4.21",
        "sonata-project/formatter-bundle": "^5.5",
        "friendsofsymfony/ckeditor-bundle": "^2.8",

        "symfony/asset": "^7.0",
        "symfony/cache": "^7.0",
        "symfony/config": "^7.0",
        "symfony/console": "^7.0",
        "symfony/doctrine-bridge": "^7.0",
        "symfony/doctrine-messenger": "^7.0",
        "symfony/dotenv": "^7.0",
        "symfony/expression-language": "^7.0",
        "symfony/flex": "^2",
        "symfony/form": "^7.0",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.0",
        "symfony/html-sanitizer": "^7.4",
        "symfony/intl": "^7.0",
        "symfony/mailer": "^7.0",
        "symfony/messenger": "^7.0",
        "symfony/monolog-bundle": "^3.10",
        "symfony/process": "^7.0",
        "symfony/property-access": "^7.0",
        "symfony/property-info": "^7.0",
        "symfony/runtime": "^7.0",
        "symfony/security-bundle": "^7.0",
        "symfony/serializer": "^7.0",
        "symfony/translation": "^7.0",
        "symfony/twig-bundle": "^7.0",
        "symfony/validator": "^7.0",
        "symfony/var-exporter": "^7.0",
        "symfony/web-link": "^7.0",
        "symfony/webpack-encore-bundle": "^2.1",
        "symfony/yaml": "^7.0",

        "twig/intl-extra": "^3.8",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.0",

        "doctrine/doctrine-fixtures-bundle": "^3.5",

        "friendsofphp/php-cs-fixer": "^3.46",

        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "phpunit/phpunit": "^10.5",


        "symfony/browser-kit": "^7.0",
        "symfony/css-selector": "^7.0",
        "symfony/debug-bundle": "^7.0",
        "symfony/maker-bundle": "^1.52",
        "symfony/phpunit-bridge": "^7.0",
        "symfony/stopwatch": "^7.0",
        "symfony/web-profiler-bundle": "^7.0"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true,
        "allow-plugins": {
            "ocramius/package-versions": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "ckeditor:install --tag=4.22.1 --clear=drop": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration"
    },
    "conflict": {
        "symfony/symfony": "*",
        "doctrine/doctrine-cache-bundle": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^7.0",
            "docker": true
        }
    }
}
