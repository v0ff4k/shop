{# templates/shop/order/create.html.twig #}
{% extends 'layout/app.html.twig' %}

{% block title %}Оформление заказа - {{ app_name }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Оформление заказа</h1>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Данные покупателя</h5>
                </div>
                <div class="card-body">
                    <form action="{{ path('shop_order_create') }}" method="POST">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('shop_action') }}">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="customer_name" class="form-label">ФИО *</label>
                                <input type="text" class="form-control" id="customer_name" 
                                       name="customer_name" required 
                                       value="{{ app.user ? app.user.fullName : '' }}">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" 
                                       value="{{ app.user ? app.user.email : '' }}" disabled>
                                <small class="text-muted">Для связи с вами</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="delivery_address" class="form-label">Адрес доставки *</label>
                            <textarea class="form-control" id="delivery_address" name="delivery_address" 
                                      rows="3" required>{{ app.user ? app.user.address : '' }}</textarea>
                        </div>

                        <div class="mb-3">
                            <label for="additional_info" class="form-label">Комментарий к заказу</label>
                            <textarea class="form-control" id="additional_info" name="additional_info" 
                                      rows="2" placeholder="Пожелания к доставке, времени и т.д.">{{ app.user ? app.user.additionalInfo : '' }}</textarea>
                        </div>

                        <hr>
                        
                        <h5 class="mb-3">Товары в заказе</h5>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Товар</th>
                                        <th>Цена</th>
                                        <th>Кол-во</th>
                                        <th>Сумма</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in items %}
                                        <tr>
                                            <td>{{ item.productTitle }}</td>
                                            <td>{{ item.productPrice }} ₽</td>
                                            <td>{{ item.quantity }}</td>
                                            <td>{{ item.subtotal }} ₽</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="3">Итого:</th>
                                        <th>{{ total }} ₽</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Подтвердить заказ
                            </button>
                            <a href="{{ path('shop_cart_index') }}" class="btn btn-outline-secondary">
                                Назад в корзину
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Ваш заказ</h5>
                    <hr>
                    <ul class="list-unstyled">
                        <li class="d-flex justify-content-between mb-2">
                            <span>Товары:</span>
                            <strong>{{ items|length }} шт.</strong>
                        </li>
                        <li class="d-flex justify-content-between mb-2">
                            <span>Сумма:</span>
                            <strong>{{ total }} ₽</strong>
                        </li>
                    </ul>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="h5">Итого:</span>
                        <span class="h5 text-primary">{{ total }} ₽</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
