{# templates/shop/home/index.html.twig #}
{% extends 'layout/app.html.twig' %}

{% block title %}{{ app_name }} - Главная{% endblock %}

{% block body %}

<div class="container mt-4">
    {# Баннер #}
    <div class="jumbotron bg-light p-5 rounded mb-4">
        <h1 class="display-4">Добро пожаловать в {{ app_name }}!</h1>
        <p class="lead">Лучший магазин с огромным выбором товаров.</p>
        <hr class="my-4">
        <a class="btn btn-primary btn-lg" href="{{ path('shop_product_index') }}" role="button">Смотреть каталог</a>
    </div>

    {# Категории #}
    <section class="mb-5">
        <h2 class="mb-3">Категории</h2>
        <div class="row">
            {% for category in categories %}
                <div class="col-md-4 col-lg-3 mb-3">
                    <div class="card h-100 d-flex flex-column">
                        {% if category.image %}
                            <img src="{{ asset_thumb_upload(category.image) }}" class="card-img-top home-category-image" alt="{{ category.title }}">
                        {% else %}
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center home-category-image">
                                <span class="text-white">{{ category.title|first }}</span>
                            </div>
                        {% endif %}
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ category.title }}</h5>
                            <a href="{{ path('shop_category_show', {slug: category.slug}) }}" class="btn btn-outline-primary btn-sm mt-auto">
                                Смотреть товары
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <p class="text-muted">Категории пока не добавлены.</p>
                </div>
            {% endfor %}
        </div>
    </section>

    {# Новые товары #}
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Новые товары</h2>
            <a href="{{ path('shop_product_index') }}" class="btn btn-outline-primary">Все товары</a>
        </div>
        <div class="row">
            {% for product in newProducts %}
                <div class="col-md-3 col-lg-2 mb-4">
                    <div class="card h-100 d-flex flex-column">
                        {% if product.images|length > 0 %}
                            <img src="{{ asset_upload(product.images[0].path) }}" class="card-img-top home-product-image" alt="{{ product.title }}">
                        {% else %}
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center home-product-image">
                                <span class="text-muted home-index">Нет фото</span>
                            </div>
                        {% endif %}
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title">{{ product.title }}</h6>
                            <div class="mt-auto row">
                                <p class="card-text font-weight-bold mb-1  col-4 col-sm-4 col-md-12">{{ product.price }} ₽</p>
                                {% if product.viewed is defined %}
                                    <p class="text-muted small mb-2  col-4 col-sm-4 col-md-12">👁 {{ product.viewed }}</p>
                                {% endif %}
                                <div class=" col-4 col-sm-4 col-md-12 row m-auto"><a href="{{ path('shop_product_show', {slug: product.slug}) }}" class="btn btn-primary btn-sm btn-block">
                                    Подробнее
                                    </a></div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <p class="text-muted">Новых товаров пока нет.</p>
                </div>
            {% endfor %}
        </div>
    </section>

    {# Популярные товары #}
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Популярные товары</h2>
            <a href="{{ path('shop_product_index', {sort_by: 'viewed', sort_order: 'desc'}) }}" class="btn btn-outline-primary">Все популярные</a>
        </div>
        <div class="row">
            {% for product in popularProducts %}
                <div class="col-md-3 col-lg-2 mb-4">
                    <div class="card h-100 d-flex flex-column">
                        {% if product.images|length > 0 %}
                            <img src="{{ asset_upload(product.images[0].path) }}" class="card-img-top home-product-image" alt="{{ product.title }}">
                        {% else %}
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center home-product-image">
                                <span class="text-muted home-index2">Нет фото</span>
                            </div>
                        {% endif %}
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title">{{ product.title }}</h6>
                            <div class="mt-auto row">
                                <p class="card-text font-weight-bold mb-1  col-4 col-sm-4 col-md-12">{{ product.price }} ₽</p>
                                {% if product.viewed is defined %}
                                    <p class="text-muted small mb-2  col-4 col-sm-4 col-md-12">👁 {{ product.viewed }}</p>
                                {% endif %}
                                <div class=" col-4 col-sm-4 col-md-12 row m-auto"><a href="{{ path('shop_product_show', {slug: product.slug}) }}" class="btn btn-primary btn-sm btn-block">
                                    Подробнее
                                    </a></div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <p class="text-muted">Популярных товаров пока нет.</p>
                </div>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}

{% block stylesheets %}
<style>
    .home-category-image {
        height: 200px;
        object-fit: contain;
        background: #f8f9fa;
    }

    .home-product-image {
        height: 170px;
        object-fit: contain;
        background: #f8f9fa;
    }
</style>
{% endblock %}
