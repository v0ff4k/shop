{# templates/emails/xml_import_result.html.twig #}
{% extends 'emails/base.html.twig' %}

{% block title %}Результат XML импорта{% endblock %}

{% block content %}
<h2>Результат XML импорта для {{ username }}</h2>

<p>XML импорт задачи <strong>{{ jobId }}</strong> завершен.</p>

<div class="info-box">
    <h3>Статистика:</h3>
    <ul>
        <li>Импортировано товаров: <strong>{{ imported }}</strong></li>
        <li>Пропущено товаров: <strong>{{ skipped }}</strong></li>
        <li>Ошибок: <strong>{{ errors }}</strong></li>
    </ul>
</div>

{% if filePath %}
<p>Исходный XML файл сохранен по пути: <code>{{ filePath }}</code></p>
{% endif %}

<p>Вы можете проверить детали задачи в разделе мониторинга задач в личном кабинете.</p>

<a href="{{ url('shop_homepage') }}" class="button">Перейти в магазин</a>

<p>Если у вас возникнут вопросы, наша служба поддержки всегда готова помочь!</p>
{% endblock %}