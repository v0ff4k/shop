                        </div>

                        {% if status.queueTelemetry.queues is defined and status.queueTelemetry.queues is not empty %}
                            <div class="table-responsive mb-3">
                                <table class="table table-sm queue-health-table align-middle">
                                    <thead>
                                    <tr>
                                        <th>Queue</th>
                                        <th>Total</th>
                                        <th>Pending</th>
                                        <th>Running</th>
                                        <th>Failed</th>
                                        <th>Oldest pending</th>
                                        <th>Status</th>
                                    </tr>
                                    </thead>
                                    <tbody id="queueTelemetryBody">
                                    {% for queueName, queue in status.queueTelemetry.queues %}
                                        <tr>
                                            <td>
                                                <strong>{{ queueName }}</strong>
