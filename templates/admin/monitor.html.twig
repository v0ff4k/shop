                    <small class="text-muted" id="logsUpdatedAt">Обновлено: только что</small>
                </div>

                <div id="logsContainer">
                {% for logType, logData in status.logs%}
                    {%  set logLen = logData|length %}


                    <div class="card mb-3">
                        <div class="card-header collapsed" data-bs-toggle="collapse" data-bs-target="#log-{{ logType }}" aria-expanded="false">
                            <i class="bi bi-file-earmark-text"></i> {{ logType|upper }} лог
                            {% if logData is iterable and logLen == 1 and logData.info is defined %}
                                <small class="p-3 text-muted">({{ logData.info }})</small>
                            {% endif %}
                            <small class="p-3 text-muted">{{ logData is empty ? '(пусто)' : '(' ~ (logLen) ~ ' ' ~ ((logLen % 10 == 1 and logLen % 100 != 11) ? 'строка' : ((logLen % 10 in 2..4 and not (logLen % 100 in 12..14)) ? 'строки' : 'строк')) ~ ')' }}</small>


                            <i class="bi bi-chevron-down float-end toggle-icon"></i>
                        </div>
                        <div id="log-{{ logType }}" class="card-body p-0 collapse" data-log-type="{{ logType }}">
                            {% if logData is iterable and logLen == 1 and logData.info is defined %}
                                <div class="p-3 text-muted">{{ logData.info }}</div>
                            {% elseif logData is empty %}
                                <div class="p-3 text-muted">Нет записей</div>
                            {% else %}
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0 small">
