                        <span class="badge bg-secondary float-end">{{ status.asyncJobs.summary.total }}</span>
                        <i class="bi bi-chevron-down float-end toggle-icon me-2"></i>
                    </div>
                    <div id="asyncJobsCard" class="card-body collapse" data-monitor-block="asyncJobs">
                        <div class="row g-3 mb-3">
                            <div class="col-6 col-md-2"><div class="card queue-card queue-metric"><div class="card-body py-3"><div class="text-muted small">Total</div><div id="asyncMetricTotal" class="fs-4 fw-bold">{{ status.asyncJobs.summary.total }}</div></div></div></div>
                            <div class="col-6 col-md-2"><div class="card queue-card queue-metric"><div class="card-body py-3"><div class="text-muted small">Pending</div><div id="asyncMetricPending" class="fs-4 fw-bold text-warning">{{ status.asyncJobs.summary.pending }}</div></div></div></div>
                            <div class="col-6 col-md-2"><div class="card queue-card queue-metric"><div class="card-body py-3"><div class="text-muted small">Running</div><div id="asyncMetricRunning" class="fs-4 fw-bold text-info">{{ status.asyncJobs.summary.running }}</div></div></div></div>
                            <div class="col-6 col-md-2"><div class="card queue-card queue-metric"><div class="card-body py-3"><div class="text-muted small">Completed</div><div id="asyncMetricCompleted" class="fs-4 fw-bold text-success">{{ status.asyncJobs.summary.completed }}</div></div></div></div>
                            <div class="col-6 col-md-2"><div class="card queue-card queue-metric"><div class="card-body py-3"><div class="text-muted small">Failed</div><div id="asyncMetricFailed" class="fs-4 fw-bold text-danger">{{ status.asyncJobs.summary.failed }}</div></div></div></div>
                            <div class="col-6 col-md-2"><div class="card queue-card queue-metric"><div class="card-body py-3"><div class="text-muted small">Backlog</div><div id="asyncMetricBacklog" class="fs-4 fw-bold">{{ status.asyncJobs.summary.pending + status.asyncJobs.summary.running }}</div></div></div></div>
                            <div class="col-12 text-muted small" id="asyncJobsUpdatedAt">Обновлено: только что</div>
                            <div class="col-12 small">
                                <span class="text-muted">By type:</span>
                                {% for type, count in status.asyncJobs.byType %}
                                    <span class="badge bg-light text-dark border me-1">{{ type }}: {{ count }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endfor %}
                                <span class="text-muted ms-3">Oldest pending:</span>
                                <span class="fw-bold" data-block="asyncJobs" data-field="oldestPendingSeconds">
                                    {{ status.asyncJobs.oldestPendingSeconds is not null ? status.asyncJobs.oldestPendingSeconds|round(0) ~ 's' : '—' }}
                                </span>
