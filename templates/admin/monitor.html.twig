                                    <div class="col-md-4">
                                        <label for="importUserID" class="form-label">user-id владельца <br />(по умольчанию ВЫ !)</label>
                                        <input id="importUserID" name="import_user_id" type="number" min="1" max="99999999" value="{{ app.user.id }}" class="form-control">
                                    </div>
                                    <div class="col-md-8">
                                        <label for="xmlFile" class="form-label">XML файл <br />(например var/storage/products.xml)</label>
                                        <input id="xmlFile" name="xml_file" type="file" class="form-control" accept=".xml,text/xml,application/xml" required>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-upload"></i> Запустить импорт
                                    </button>
                                    <span class="text-muted small">Файл попадёт в очередь и будет обработан в фоне.</span>
                                </div>
                                <div id="xmlImportStatus" class="xml-status small"></div>
                            </form>
                        </div>
                    </div>
                </div>
                {# XML export  #}
                <div class="col-md-6">
                    <div class="card xml-panel">
                        <div class="card-header collapsed" data-bs-toggle="collapse" data-bs-target="#xmlExportCard" aria-expanded="false">
                            <i class="bi bi-download"></i> XML Export
                            <span class="badge bg-primary float-end">async</span>
                            <i class="bi bi-chevron-down float-end toggle-icon me-2"></i>
                        </div>
                        <div id="xmlExportCard" class="card-body collapse">
                            <p class="xml-help mb-3">
                                Экспорт создаётся асинхронно. Можно указать список `product_ids` через запятую
                                или оставить пустым, чтобы выгрузить товары по `limit`.
                            </p>
                            <form id="xmlExportForm" class="vstack gap-3">
                                <div>
                                    <label for="exportProductIds" class="form-label">Product IDs</label>
                                    <textarea id="exportProductIds" name="product_ids" class="form-control" rows="3" placeholder="1, 2, 3"></textarea>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label for="exportUserID" class="form-label" title="ID пользователя, кому будет экспорт,">userID<sup>*</sup></label>
                                        <input id="exportUserID" name="export_user_id" type="number" min="1" max="99999999" value="{{ app.user.id }}" class="form-control">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="exportLimit" class="form-label">Limit</label>
                                        <input id="exportLimit" name="limit" type="number" min="1" max="5000" value="1000" class="form-control">
