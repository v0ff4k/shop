                                                <th style="width: 100px;">Канал</th>
                                                <th>Сообщение</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for line in logData %}
                                                <tr>
                                                    <td class="text-muted">{{ line.datetime|default('—') }}</td>
                                                    <td>
                                                        {% set levelClass = '' %}
