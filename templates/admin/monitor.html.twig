                                                            {% set levelClass = 'text-danger fw-bold' %}
                                                        {% elseif line.level == 'WARNING' %}
                                                            {% set levelClass = 'text-warning' %}
                                                        {% elseif line.level == 'INFO' %}
                                                            {% set levelClass = 'text-info' %}
                                                        {% endif %}
                                                        <span class="{{ levelClass }}">{{ line.level }}</span>
                                                    </td>
                                                    <td><code>{{ line.channel }}</code></td>
                                                    <td class="text-break">{{ line.message }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
                </div>
            </div>
