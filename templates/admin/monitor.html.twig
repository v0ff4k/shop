    {# Bootstrap 5 JS (необходим для collapse) #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.getElementById('clearCacheBtn').addEventListener('click', function() {
            const btn = this;
            const status = document.getElementById('clearCacheStatus');

            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Очистка...';
            status.style.display = 'inline';
            status.innerHTML = '<span class="text-info">Очистка кеша...</span>';

            fetch('/admin/monitor/clear-cache', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-trash"></i> Очистить весь кеш';
                status.innerHTML = '<span class="text-success"><i class="bi bi-check"></i> Кеш очищен!</span>';

                setTimeout(() => {
                    status.style.display = 'none';
                }, 3000);
            })
            .catch(error => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-trash"></i> Очистить весь кеш';
                status.innerHTML = '<span class="text-danger"><i class="bi bi-x"></i> Ошибка очистки кеша</span>';
            });
        });

        document.addEventListener('click', function(event) {
            const button = event.target.closest('.retry-job-btn');
            if (!button) {
                return;
            }

            const jobId = button.getAttribute('data-job-id');
            button.disabled = true;
            button.innerText = 'Retrying...';

            fetch(`/admin/monitor/async-jobs/${jobId}/retry`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then((response) => response.json())
            .then(() => {
                refreshMonitorLiveData();
            })
            .catch(() => {
                button.disabled = false;
                button.innerText = 'Retry';
            });
        });

        function escapeHtml(value) {
            const div = document.createElement('div');
            div.textContent = value ?? '';
            return div.innerHTML;
        }

        const blockUrlTemplate = '{{ path('admin_monitor_block', {block: '__BLOCK__'}) }}';
        const logsUrl = '{{ path('admin_monitor_logs') }}';

        function updateBlockFields(block, data) {
            Object.entries(data || {}).forEach(([field, value]) => {
                if (value === null || value === undefined) {
                    return;
                }
                if (!['string', 'number', 'boolean'].includes(typeof value)) {
                    return;
                }

                const target = document.querySelector(`[data-block="${block}"][data-field="${field}"]`);
                if (!target) {
                    return;
                }

                let rendered = String(value);
                if (field === 'memoryPercent' || field === 'hitRate') {
                    rendered += '%';
                } else if (field === 'oldestPendingSeconds') {
                    rendered = `${Math.round(Number(value))}s`;
                }
                target.textContent = rendered;
            });

            const summary = data.summary || null;
            if (summary) {
                const mapping = {
                    asyncMetricTotal: summary.total,
                    asyncMetricPending: summary.pending,
                    asyncMetricRunning: summary.running,
                    asyncMetricCompleted: summary.completed,
                    asyncMetricFailed: summary.failed,
                    asyncMetricBacklog: (summary.pending || 0) + (summary.running || 0),
                };
                Object.entries(mapping).forEach(([id, value]) => {
                    const element = document.getElementById(id);
                    if (element) {
                        element.textContent = value ?? 0;
                    }
                });
            }

            if (data.health) {
                renderQueueRows(data.health);
            }
            if (data.jobs) {
                renderJobRows(data.jobs);
            }
        }

        async function refreshBlock(block) {
            const updated = document.querySelector(`[data-block-updated="${block}"]`);
            if (updated) {
                updated.textContent = 'обновление…';
            }

            try {
                const url = blockUrlTemplate.replace('__BLOCK__', encodeURIComponent(block));
                const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const payload = await response.json();
                updateBlockFields(block, payload.data || {});

                if (updated) {
                    updated.textContent = new Date().toLocaleTimeString();
                }
            } catch (error) {
                if (updated) {
                    updated.textContent = 'ошибка обновления';
                }
            }
        }

        async function loadLogChunk(type, container) {
            try {
                const response = await fetch(`${logsUrl}?type=${encodeURIComponent(type)}&limit=50`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!response.ok) {
                    return;
                }

                const data = await response.json();
                const lines = Array.isArray(data.lines) ? data.lines : [];

                if (lines.length === 0) {
                    container.innerHTML = `<div class="p-3 text-muted">${escapeHtml(data.info || 'Нет записей')}</div>`;
                    return;
                }

                const rows = lines.map((line) => {
                    const level = String(line.level || 'INFO');
                    const levelClass = level === 'ERROR' || level === 'CRITICAL'
                        ? 'text-danger fw-bold'
                        : (level === 'WARNING' ? 'text-warning' : (level === 'INFO' ? 'text-info' : ''));
                    return `<tr>
                        <td class="text-muted">${escapeHtml(line.datetime || '—')}</td>
                        <td><span class="${levelClass}">${escapeHtml(level)}</span></td>
                        <td><code>${escapeHtml(line.channel || 'app')}</code></td>
                        <td class="text-break">${escapeHtml(line.message || '')}</td>
                    </tr>`;
                }).join('');

                container.innerHTML = `<div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 small">
                        <thead><tr><th style="width: 150px;">Время</th><th style="width: 80px;">Уровень</th><th style="width: 100px;">Канал</th><th>Сообщение</th></tr></thead>
                        <tbody>${rows}</tbody>
                    </table>
                </div>
                <div class="text-muted small p-2">Показаны последние ${lines.length} строк (обновлено ${new Date().toLocaleTimeString()})</div>`;
            } catch (error) {
                // Оставляем уже отрисованные логи при ошибке.
            }
        }

        document.addEventListener('click', function(event) {
            const refreshButton = event.target.closest('.refresh-block-btn');
            if (!refreshButton) {
                return;
            }

            event.preventDefault();
            event.stopImmediatePropagation();
            refreshBlock(refreshButton.getAttribute('data-refresh-block'));
        });

        document.addEventListener('shown.bs.collapse', function(event) {
            const block = event.target.getAttribute('data-monitor-block');
            if (block) {
                refreshBlock(block);
                if (block === 'prometheus') {
                    refreshBlock('grafana');
                    refreshBlock('jaeger');
                }
            }

            const logType = event.target.getAttribute('data-log-type');
            if (logType) {
                loadLogChunk(logType, event.target);
            }
        });

        function renderQueueRows(queues) {
            const body = document.getElementById('queueTelemetryBody');
            if (!body) {
                return;
            }

            const entries = Object.entries(queues || {});
            if (entries.length === 0) {
                body.innerHTML = '<tr><td colspan="7" class="text-muted">Очереди не найдены.</td></tr>';
                return;
            }

            body.innerHTML = entries.map(([name, queue]) => {
                const statusBadge = queue.status === 'ok'
                    ? '<span class="badge bg-success">healthy</span>'
                    : (queue.status === 'warning'
                        ? '<span class="badge bg-warning text-dark">watch</span>'
                        : '<span class="badge bg-danger">critical</span>');
                const oldest = queue.oldest_pending_seconds !== null
                    ? `${Math.round(queue.oldest_pending_seconds)}s`
                    : '—';
                const updated = queue.last_updated_at
                    ? `<div class="text-muted small">updated ${escapeHtml(queue.last_updated_at)}</div>`
                    : '';

                return `<tr>
                    <td><strong>${escapeHtml(name)}</strong>${updated}</td>
                    <td>${escapeHtml(queue.total)}</td>
                    <td>${escapeHtml(queue.pending)}</td>
                    <td>${escapeHtml(queue.running)}</td>
                    <td>${escapeHtml(queue.failed)}</td>
                    <td>${oldest}</td>
                    <td>${statusBadge}</td>
                </tr>`;
            }).join('');
        }

        function renderJobRows(jobs) {
            const body = document.getElementById('asyncJobsBody');
            if (!body) {
                return;
            }

            if (!jobs || jobs.length === 0) {
                body.innerHTML = '<tr><td colspan="6" class="text-muted">Задачи не найдены.</td></tr>';
                return;
            }

            body.innerHTML = jobs.map((job) => {
                const status = job.status || 'pending';
                const badge = status === 'completed'
                    ? '<span class="badge bg-success">completed</span>'
                    : (status === 'failed'
                        ? '<span class="badge bg-danger">failed</span>'
                        : (status === 'running'
                            ? '<span class="badge bg-info">running</span>'
                            : `<span class="badge bg-warning text-dark">${escapeHtml(status)}</span>`));
                const retry = status === 'failed' && job.type === 'xml_export'
                    ? `<button class="btn btn-sm btn-outline-primary retry-job-btn" data-job-id="${escapeHtml(job.job_id)}">Retry</button>`
                    : '<span class="text-muted">—</span>';
                const jobId = String(job.job_id || '').slice(0, 16);

                return `<tr>
                    <td><code>${escapeHtml(jobId)}...</code></td>
                    <td>${escapeHtml(job.type)}</td>
                    <td>${badge}</td>
                    <td>${escapeHtml(job.updated_at || '—')}</td>
                    <td class="text-danger">${escapeHtml(job.error || '—')}</td>
                    <td>${retry}</td>
                </tr>`;
            }).join('');
        }

        function renderLogs(logs) {
            const container = document.getElementById('logsContainer');
            if (!container) {
                return;
            }

            const entries = Object.entries(logs || {});
            if (entries.length === 0) {
                container.innerHTML = '<div class="text-muted">Логи не найдены.</div>';
                return;
            }

            container.innerHTML = entries.map(([type, lines]) => {
                if (!Array.isArray(lines)) {
                    const info = escapeHtml(lines && lines.info ? lines.info : 'Нет данных');
                    return `<div class="card mb-3"><div class="card-header"><i class="bi bi-file-earmark-text"></i> ${escapeHtml(type.toUpperCase())} лог</div><div class="card-body text-muted">${info}</div></div>`;
                }

                const rows = lines.map((line) => {
                    const level = String(line.level || 'INFO');
                    const levelClass = level === 'ERROR' || level === 'CRITICAL'
                        ? 'text-danger fw-bold'
                        : (level === 'WARNING' ? 'text-warning' : (level === 'INFO' ? 'text-info' : ''));
                    return `<tr>
                        <td class="text-muted">${escapeHtml(line.datetime || '—')}</td>
                        <td><span class="${levelClass}">${escapeHtml(level)}</span></td>
                        <td><code>${escapeHtml(line.channel || 'app')}</code></td>
                        <td class="text-break">${escapeHtml(line.message || '')}</td>
                    </tr>`;
                }).join('');

                return `<div class="card mb-3">
                    <div class="card-header"><i class="bi bi-file-earmark-text"></i> ${escapeHtml(type.toUpperCase())} лог <small class="text-muted">(${lines.length})</small></div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0 small">
                                <thead><tr><th style="width: 150px;">Время</th><th style="width: 80px;">Уровень</th><th style="width: 100px;">Канал</th><th>Сообщение</th></tr></thead>
                                <tbody>${rows}</tbody>
                            </table>
                        </div>
                    </div>
                </div>`;
            }).join('');
        }

        async function refreshMonitorLiveData() {
            if (document.hidden) {
                return;
            }

            try {
                const response = await fetch('{{ path('admin_monitor_live') }}', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!response.ok) {
                    return;
                }

                const data = await response.json();
                const summary = data.asyncJobs.summary || {};

                document.getElementById('asyncMetricTotal').textContent = summary.total ?? 0;
                document.getElementById('asyncMetricPending').textContent = summary.pending ?? 0;
                document.getElementById('asyncMetricRunning').textContent = summary.running ?? 0;
                document.getElementById('asyncMetricCompleted').textContent = summary.completed ?? 0;
                document.getElementById('asyncMetricFailed').textContent = summary.failed ?? 0;
                document.getElementById('asyncMetricBacklog').textContent = (summary.pending ?? 0) + (summary.running ?? 0);

                renderQueueRows(data.asyncJobs.health || {});
                renderJobRows(data.asyncJobs.jobs || []);

                const updatedAt = data.updatedAt ? new Date(data.updatedAt).toLocaleTimeString() : 'только что';
                document.getElementById('asyncJobsUpdatedAt').textContent = `Обновлено: ${updatedAt}`;
                document.getElementById('logsUpdatedAt').textContent = `Обновлено: ${updatedAt}`;
            } catch (error) {
                // Страница остаётся рабочей при временной недоступности endpoint'а.
            }
        }

        setInterval(refreshMonitorLiveData, 15000);

        const xmlImportForm = document.getElementById('xmlImportForm');
        const xmlImportStatus = document.getElementById('xmlImportStatus');
        const xmlExportForm = document.getElementById('xmlExportForm');
        const xmlExportStatus = document.getElementById('xmlExportStatus');

        function renderXmlStatus(target, type, message, jobId = null) {
            const badge = type === 'success'
                ? 'success'
                : (type === 'warning' ? 'warning text-dark' : (type === 'danger' ? 'danger' : 'info'));

            target.innerHTML = `
                <div class="alert alert-${badge} py-2 mb-0">
                    ${message}${jobId ? ` <code>${jobId}</code>` : ''}
                </div>
            `;
        }

        async function submitXmlForm(form, endpoint, target) {
            const formData = new FormData(form);
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Отправка...';
            renderXmlStatus(target, 'info', 'Запрос отправлен, ожидаем ответ...');

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                const data = await response.json();

                if (!response.ok) {
                    renderXmlStatus(target, 'danger', data.error || 'Ошибка выполнения');
                    return;
                }

                renderXmlStatus(target, 'success', data.message || 'Задача поставлена в очередь', data.job_id || null);
                window.location.reload();
            } catch (error) {
                renderXmlStatus(target, 'danger', 'Ошибка отправки запроса');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }

        xmlImportForm?.addEventListener('submit', function(event) {
            event.preventDefault();
            submitXmlForm(xmlImportForm, '{{ path('admin_xml_import') }}', xmlImportStatus);
        });

        xmlExportForm?.addEventListener('submit', function(event) {
            event.preventDefault();
            submitXmlForm(xmlExportForm, '{{ path('admin_xml_export') }}', xmlExportStatus);
        });
    </script>
</body>
</html>
