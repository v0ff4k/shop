{% trans_default_domain 'FOSUserBundle' %}

<form action="{{ path('fos_user_change_password') }}" enctype="multipart/form-data" method="POST"
      class="fos_user_change_password">
    {{ form_widget(form) }}
    <div>
        <input class="btn btn-warning" type="submit" value="{{ 'change_password.submit'|trans({}, 'FOSUserBundle') }}"/>
    </div>
</form>

