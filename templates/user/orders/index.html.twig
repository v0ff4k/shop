{# templates/user/orders/index.html.twig #}
{% extends 'layout/app.html.twig' %}

{% block title %}Мои заказы - {{ app_name }}{% endblock %}

{% block body %}
<div class="container mt-3 mt-md-4">
    <nav aria-label="breadcrumb" class="mb-3 mb-md-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('shop_homepage') }}">Главная</a></li>
            <li class="breadcrumb-item"><a href="{{ path('user_profile') }}">Профиль</a></li>
            <li class="breadcrumb-item active">Мои заказы</li>
        </ol>
    </nav>

    <h1 class="mb-4 fs-4 fs-md-3">Мои заказы</h1>

    {% if orders is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> У вас пока нет заказов.
            <a href="{{ path('shop_homepage') }}" class="alert-link">Перейти к покупкам</a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover small">
                <thead>
                    <tr>
                        <th>№ заказа</th>
                        <th>Дата</th>
                        <th>Сумма</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td>
                                <strong>{{ order.order_number }}</strong>
                                <br><small class="text-muted">#{{ order.id }}</small>
                            </td>
                            <td>{{ order.created_at|date('d.m.Y H:i') }}</td>
                            <td>{{ order.total_amount }} ₽</td>
                            <td>
                                {% set statusColors = {
                                    'new': 'info',
                                    'processing': 'warning',
                                    'shipped': 'primary',
                                    'delivered': 'success',
                                    'cancelled': 'danger'
                                } %}
                                {% set statusLabels = {
                                    'new': 'Новый',
                                    'processing': 'В обработке',
                                    'shipped': 'Отправлен',
                                    'delivered': 'Доставлен',
                                    'cancelled': 'Отменён'
                                } %}
                                <span class="badge bg-{{ statusColors[order.status] ?? 'secondary' }}">
                                    {{ statusLabels[order.status] ?? order.status }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('shop_order_success', {orderNumber: order.order_number}) }}"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> <span class="d-none d-sm-inline">Просмотр</span>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
