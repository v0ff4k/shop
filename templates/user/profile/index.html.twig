{# templates/user/profile/index.html.twig #}
{% extends 'layout/app.html.twig' %}

{% block title %}Профиль - {{ app_name }}{% endblock %}

{% block body %}
<div class="container mt-3 mt-md-4">
    <h1 class="mb-4 fs-4 fs-md-3">Мой профиль</h1>

    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0 fs-6">Личная информация</h5>
                </div>
                <div class="card-body">
                    <form action="{{ path('user_profile') }}" method="POST">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('shop_action') }}">
                        <div class="row g-3">
                            <div class="col-12 col-md-6 mb-3">
                                <label for="username" class="form-label">Логин</label>
                                <input type="text" class="form-control" id="username"
                                       value="{{ user.username }}" disabled>
                                <small class="text-muted">Нельзя изменить</small>
                            </div>

                            <div class="col-12 col-md-6 mb-3">
                                <label for="email" class="form-label">Email *</label>
                                <input type="email" class="form-control" id="email" name="email"
                                       value="{{ user.email }}" required>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6 mb-3">
                                <label for="full_name" class="form-label">ФИО</label>
                                <input type="text" class="form-control" id="full_name" name="full_name"
                                       value="{{ user.fullName }}">
                            </div>

                            <div class="col-12 col-md-6 mb-3">
                                <label for="phone" class="form-label">Телефон</label>
                                <input type="tel" class="form-control" id="phone" disabled>
                                <small class="text-muted">Будет доступно позже</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="address" class="form-label">Адрес</label>
                            <textarea class="form-control" id="address" name="address"
                                      rows="2">{{ user.address }}</textarea>
                        </div>

                        <div class="mb-3">
                            <label for="additional_info" class="form-label">Дополнительная информация</label>
                            <textarea class="form-control" id="additional_info" name="additional_info"
                                      rows="2">{{ user.additionalInfo }}</textarea>
                        </div>

                        <hr>

                        <h5 class="mb-3 fs-6">Смена пароля</h5>

                        <div class="mb-3">
                            <label for="current_password" class="form-label">Текущий пароль</label>
                            <input type="password" class="form-control" id="current_password"
                                   name="current_password">
                        </div>

                        <div class="mb-3">
                            <label for="new_password" class="form-label">Новый пароль</label>
                            <input type="password" class="form-control" id="new_password"
                                   name="new_password">
                            <small class="text-muted">Оставьте пустым, чтобы не менять</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                Сохранить изменения
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card mb-4">
                <div class="card-body text-center">
                    <i class="bi bi-person-circle" style="font-size: 4rem; color: #6c757d;" title="#{{ user.id }}"></i>
                    <h5 class="mt-3 fs-6">{{ user.username }}</h5>
                    <p class="text-muted small">{{ user.email }}</p>

                    {% if user.roles is iterable %}
                        {% for role in user.roles %}
                            {% if role != 'ROLE_USER' %}
                                <span class="badge bg-primary">{{ role }}</span>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h6 class="card-title fs-6">Информация об аккаунте</h6>
                    <ul class="list-unstyled small">
                        {% if user.registeredAt %}
                            <li class="mb-2">
                                <strong>Зарегистрирован:</strong><br>
                                {{ user.registeredAt|date('d.m.Y H:i') }}
                            </li>
                        {% endif %}
                        {% if user.lastLoginAt %}
                            <li class="mb-2">
                                <strong>Последний вход:</strong><br>
                                {{ user.lastLoginAt|date('d.m.Y H:i') }}
                            </li>
                        {% endif %}
                        <li>
                            <strong>Статус:</strong><br>
                            {% if user.enabled %}
                                <span class="badge bg-success">Активен</span>
                            {% else %}
                                <span class="badge bg-danger">Заблокирован</span>
                            {% endif %}
                        </li>
                    </ul>
                    <hr>
                    <div class="d-grid gap-2">
                        <a href="{{ path('user_orders') }}" class="btn btn-outline-primary">
                            <i class="bi bi-box-seam"></i> Мои заказы
                        </a>
                        <a href="{{ path('shop_homepage') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-shop"></i> Перейти к покупкам
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
