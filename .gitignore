/phpunit.xml.dist
###< symfony/phpunit-bridge ###

###> symfony/swiftmailer-bundle ###
###< symfony/swiftmailer-bundle ###

###> symfony/webpack-encore-bundle ###
/node_modules
/public/build/
npm-debug.log
yarn-error.log
###< symfony/webpack-encore-bundle ###

###> vendor ###
/vendor/
###< symfony/webpack-encore-bundle ###

###> doctrine/dbal ###
/bin/var
/databases/*.db
###< doctrine/dbal ###

###> var ###
/var/
!var/.gitkeep
!var/spool/email/.gitkeep
###< var ###

###> .env ###
.env.local
.env.local.php
.env.*.local
###< .env ###

###> phpunit ###
/phpunit.php
###< phpunit ###

###> php-cs-fixer ###
/.php-cs-fixer.cache
/.php-cs-fixer.dist.php
/.php-cs-fixer.php
###< php-cs-fixer ###

###> Docker ###
/docker-compose.override.yml
/docker/logs
###< Docker ###

###> IDE ###
/.idea/
/nbproject/
*.iml
*.ipr
*.iws
.vscode/
*.sublime-project
*.sublime-workspace
/*.md
mandatory_senior_checklist.md
MISSING_FEATURES_CHECKLIST.md
PROJECT_STATUS.md
PROJECT_MEMORY.md
SENIOR_LEVEL_AUDIT.md
!README.md
!TODO.md
!INSTALL.md
.*/

###< IDE ###

###> OS ###
.DS_Store
Thumbs.db
desktop.ini
###< OS ###

###> Logs ###
*.log
.zip
###< Logs ###

###> Uploads ###
/public/uploads/*
!/public/uploads/.gitkeep
# generated bundles
/public/bundles
#local php/py/go scripts
/public/scripts
###< Uploads ###

###> Cache ###
/cache/
###< Cache ###

###> Secrets ###
/config/secrets/*.decrypt.private.php
/config/secrets/*.encrypt.public.php
/config/secrets/prod.decrypt.private.php
###< Secrets ###

/old_app

###> phpunit/phpunit ###
/phpunit.xml
/.phpunit.cache/
/.phpunit.result.cache
/bin/.phpunit
###< phpunit/phpunit ###

###> HTTP IDE Client Tests ###
/tests/http/http-client.private.env.json
/tests/http/http-client.env.json
!/tests/http/http-client.private.env.json.example
###< HTTP IDE Client Tests ###

