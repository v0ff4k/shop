# Production environment variables
# Скопируйте этот файл в .env.prod и заполните значениями

# Database
DB_NAME=shop
DB_USER=shop_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# RabbitMQ
RABBITMQ_USER=shop_user
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Observability URLs
# Internal URLs are resolved inside the Docker/private network.
PROMETHEUS_INTERNAL_URL=http://prometheus:9090
GRAFANA_INTERNAL_URL=http://grafana:3000
JAEGER_INTERNAL_URL=http://jaeger:16686
# Public URLs are opened by the administrator's browser.
GRAFANA_URL=https://grafana.example.com
PROMETHEUS_URL=https://prometheus.example.com
JAEGER_URL=https://jaeger.example.com

# Grafana
GRAFANA_ROOT_URL=https://metrics.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Application
APP_ENV=prod
APP_SECRET=CHANGE_ME_GENERATE_32_CHAR_SECRET
APP_DEBUG=0
DOCTRINE_TRACING_ENABLED=0
DOCTRINE_TRACING_LOG_QUERIES=0

# External APIs
PAYMENT_API_URL=https://api.payment-gateway.example
PAYMENT_API_KEY=CHANGE_ME_API_KEY

# Email
MAILER_DSN=smtp://user:pass@smtp.example.com:587
EMAIL_SPOOL_ENABLED=false

# XML import: сколько товаров обрабатывать за один flush()/clear()
XML_IMPORT_BATCH_SIZE=100
